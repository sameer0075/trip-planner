# Copy to .env for local development outside Docker; every variable is optional in DEBUG mode.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Set to the number of proxies in front of the app (e.g. 1 on Render) for accurate throttling.
NUM_PROXIES=
# Self-hosted map services can replace the public demo servers.
OSRM_BASE_URL=https://router.project-osrm.org
PHOTON_BASE_URL=https://photon.komoot.io
